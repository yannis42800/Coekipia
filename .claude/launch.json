{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-node",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend-node", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend-java",
      "runtimeExecutable": "java",
      "runtimeArgs": ["-cp", "backend-java/out", "com.coekipia.filtrage.Server"],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "5173", "frontend"],
      "port": 5173
    }
  ]
}
